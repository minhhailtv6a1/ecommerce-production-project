# Application
APP_NAME=Image-Based Product Search API
APP_ENV=development
API_PREFIX=/api/v1
# JSON list of exact browser origins; do not use wildcard with credentials.
CORS_ORIGINS=["http://localhost:3000"]

# Model artifact (the file is not included in this scaffold)
MODEL_PATH=artifacts/alexnet.pth
CLASSIFIER_ARTIFACT_ROOT=artifacts/classifiers
CLASSIFIER_DEVICE=auto
CLASSIFIER_DEFAULT_MODEL=none
CLASSIFIER_TOP_K=5
CLASSIFIER_MAX_TOP_K=10

# Pinecone (replace placeholders only when the integration is implemented)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
PINECONE_NAMESPACE=your-namespace
# These values must match the embedding pipeline; do not guess the dimension.
PINECONE_VECTOR_FIELD=image_vector
PINECONE_DIMENSION=512
# Allowed metrics: cosine, euclidean, dotproduct
PINECONE_METRIC=cosine
# Copy a supported cloud and region from the Pinecone project configuration.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DELETION_PROTECTION=enabled
PINECONE_CREATE_TIMEOUT=300

# CLIP image embedding and ingestion
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
CLIP_DEVICE=auto
CLIP_CACHE_DIR=
INGEST_DATASET_PATH=path/to/E-commerce_Product_Dataset/train
INGEST_BATCH_SIZE=64
SEARCH_TEST_DATASET_PATH=path/to/E-commerce_Product_Dataset/test

# Supabase PostgreSQL connection
# Copy the exact host, port, and user from the Supabase Dashboard Connect dialog.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_SSL_MODE=require

# Supabase Storage API (server-side/script only; separate from DB connection)
# Prefer a new sb_secret_... key. A legacy service_role JWT is also supported.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=product-images
# Set true only when the bucket is public and product URLs may be exposed.
SUPABASE_STORAGE_BUCKET_PUBLIC=false
SUPABASE_STORAGE_UPLOAD_WORKERS=4
# Standard upload is recommended for files up to 6 MiB.
SUPABASE_STORAGE_TIMEOUT_SECONDS=60
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=3600
SUPABASE_STORAGE_MAX_STANDARD_UPLOAD_BYTES=6291456

# Public image-search upload limits
IMAGE_UPLOAD_MAX_BYTES=10485760
IMAGE_UPLOAD_MAX_PIXELS=25000000
IMAGE_SEARCH_DEFAULT_LIMIT=50
IMAGE_SEARCH_MAX_LIMIT=50
IMAGE_SEARCH_TOP_K=50

# Authentication. Generate a unique value with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=image-search-api
JWT_AUDIENCE=image-search-web
