# ==============================================================================
# Root .gitignore for E-commerce Production Project
# ==============================================================================

# Operating Systems
.DS_Store
Thumbs.db
desktop.ini

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# Environment variables & secrets
.env
.env.*
.env.local
.env.*.local
!.env.example

# Node.js / Frontend
node_modules/
.npm-cache/
.next/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
myenv/
.venv/
venv/
env/
.pytest_cache/
.pytest-tmp/
pytest-cache-files-*/
.artifact-csv-check/
.coverage
htmlcov/
*.log

# Model weights & large binary checkpoints (keep directory via .gitkeep)
artifacts/*
!artifacts/.gitkeep
*.pth
*.pt
*.ckpt
*.checkpoint
*.onnx

# docker-compose file
docker-compose.yml